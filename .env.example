# === 主資料源：OddsPapi v4（api.oddspapi.io）===
ODDSPAPI_API_KEY=

# === AI 分析：Google Gemini（aistudio.google.com）===
GEMINI_API_KEY=

# === Discord 推播 webhook（4 頻道；值自填，留空＝該頻道不推）===
DISCORD_WEBHOOK_URL=              # 📋-推薦單（正式推薦）
DISCORD_TEST_WEBHOOK_URL=        # 🧪-測試（TEST_MODE 推這；留空→測試模式略過推播）
DISCORD_BACKTEST_WEBHOOK_URL=    # 📊-回測戰報（env 在位，推播功能後續）
DISCORD_ALERT_WEBHOOK_URL=       # ⚠️-系統告警（env 在位，推播功能後續）

# === 資料輸出目錄 ===
DATA_DIR=./data

# === 測試模式（true=隔離到 data/test/、加 🧪 標記 / false=正式）===
TEST_MODE=true

# 註：CI（GitHub Actions）環境改用 GitHub Secrets 注入，不讀此檔。
# 架構 A：API-Football / BALLDONTLIE 已停用（見 docs/arch_A_proposal.md）。
