# === 主資料源：API-Football（dashboard.api-football.com）===
API_FOOTBALL_KEY=

# === 備援/交叉驗證：BALLDONTLIE（balldontlie.io）===
BALLDONTLIE_API_KEY=

# === AI 分析：Google Gemini（aistudio.google.com）===
GEMINI_API_KEY=

# === Discord 推播 webhook ===
DISCORD_WEBHOOK_URL=

# === 資料輸出目錄 ===
DATA_DIR=./data

# === 測試模式（true=隔離到 data/test/、加 🧪 標記 / false=正式）===
TEST_MODE=true

# 註：CI（GitHub Actions）環境改用 GitHub Secrets 注入，不讀此檔。
